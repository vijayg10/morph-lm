# Server
HOST=0.0.0.0
PORT=3000

# Auth
API_KEY=your-secret-api-key-here

# Agent Configuration
ENABLE_GEMINI=true
ENABLE_CLAUDE=true
ENABLE_AIDER=true

# Workspace Security (comma-separated allowed paths)
WORKSPACES=/repos,/projects,/workspaces

# Logging
LOG_LEVEL=info

# Agent Execution
AGENT_TIMEOUT_MS=300000
AGENT_CONCURRENCY_LIMIT=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
